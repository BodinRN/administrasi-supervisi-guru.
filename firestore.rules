rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // supervisi_records: setiap guru hanya bisa baca/tulis dokumen milik sendiri
    match /supervisi_records/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tolak semua akses lainnya secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
